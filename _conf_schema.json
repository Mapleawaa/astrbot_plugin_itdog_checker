{
  "service_url": {
    "type": "string",
    "description": "本地服务端地址",
    "hint": "例如 http://127.0.0.1:8765",
    "default": "http://127.0.0.1:8765"
  },
  "service_token": {
    "type": "string",
    "description": "服务端鉴权 Token",
    "hint": "可留空；与服务端 ITDOG_SERVICE_TOKEN 保持一致",
    "default": "",
    "invisible": true
  },
  "timezone": {
    "type": "string",
    "description": "限流时区",
    "hint": "默认 Asia/Shanghai",
    "default": "Asia/Shanghai"
  },
  "daily_limit": {
    "type": "int",
    "description": "普通用户每日上限",
    "hint": "按配置时区统计自然日；管理员不受限制",
    "default": 20
  },
  "cooldown_seconds": {
    "type": "int",
    "description": "普通用户冷却时间(秒)",
    "hint": "每次调用后需等待的秒数；管理员不受限制",
    "default": 60
  },
  "admins": {
    "type": "text",
    "description": "管理员列表",
    "hint": "每行一个用户标识（优先按用户ID匹配；没有ID时按昵称匹配）",
    "default": ""
  },
  "edit_message_if_possible": {
    "type": "bool",
    "description": "尽量编辑首条消息",
    "hint": "仅在平台支持“编辑消息”能力时生效（如 Telegram）；不支持则自动改为发送第二条",
    "default": true
  }
}
